       "format": 0,
       "mode": "normal",
       "style": "",
       "text": "אוטובוסים אלו מסומנים בסמל הנגישות הבינלאומי בחזית האוטובוס ובדופן הימני.",
       "type": "text",
       "version": 1
      }
     ],
     "direction": null,
