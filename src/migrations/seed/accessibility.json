      {
       "detail": 0,
       "format": 0,
       "mode": "normal",
       "style": "",
       "text": "ניתן לקבל מידע על הקווים הנגישים בחברה במספר דרכים:",
       "type": "text",
       "version": 1
      }
     ],
     "direction": null,
     "format": "",
     "indent": 0,
     "type": "paragraph",
     "version": 1,
     "textFormat": 0,
     "textStyle": ""
    },
    {
     "children": [
      {
       "children": [
        {
         "detail": 0,
         "format": 0,
         "mode": "normal",
         "style": "",
         "text": "באתר האינטרנט של החברה.",
         "type": "text",
         "version": 1
        }
       ],
       "direction": null,
       "format": "",
       "indent": 0,
       "type": "listitem",
       "version": 1,
       "value": 1
      },
      {
       "children": [
        {
         "detail": 0,
         "format": 0,
         "mode": "normal",
         "style": "",
         "text": "מנציגי השירות של החברה במחלקת פניות הציבור בטלפון ",
         "type": "text",
         "version": 1
        },
        {
         "children": [
          {
           "detail": 0,
           "format": 0,
           "mode": "normal",
