# ---- Local development (npm run dev) ----
# DATABASE_URL=postgres://localhost:5432/hebrew_cms
# PAYLOAD_SECRET=any-long-random-string

# ---- Server deployment (docker compose) — copy to .env and fill in ----
# uid/gid of the server account (run `id -u` and `id -g` on the server)
APP_UID=1041
APP_GID=1041

# Database created by the db container. Use letters/digits only in the password
# (it goes into a URL). Generate one with: openssl rand -hex 24
POSTGRES_USER=electra
POSTGRES_PASSWORD=
POSTGRES_DB=electra

# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Do NOT set BLOB_READ_WRITE_TOKEN on the server: without it, media is stored
# locally in ./media instead of Vercel Blob.
